{
  "providers": [
    {
      "id": "atlas-openai",
      "name": "Atlas OpenAI",
      "api": "openai-responses",
      "baseUrl": "${settings.openaiBaseUrl}",
      "apiKey": "$OPENAI_API_KEY",
      "models": [
        {
          "id": "example-openai-reasoner",
          "name": "Example OpenAI Reasoner",
          "api": "openai-responses",
          "reasoning": true,
          "input": ["text", "image"],
          "contextWindow": 400000,
          "maxTokens": 128000,
          "cost": {
            "input": 0,
            "output": 0,
